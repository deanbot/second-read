{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/cli.ts", "claude-hook"],
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
